@startuml Diagramme_de_classes_simplifié
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam ClassBorderColor #555555
skinparam ClassBackgroundColor #F8F8F8
skinparam PackageBorderColor #888888

title Diagramme de classes -- Plateforme Vidéo

' ============================================================
' ENUMERATIONS
' ============================================================
together {
  enum "«Enumeration»\nRôle" as ERole {
    UTILISATEUR
    ADMINISTRATEUR
  }

  enum "«Enumeration»\nStatutVidéo" as EStatus {
    EN_ATTENTE
    PUBLIÉE
    REJETÉE
  }

  enum "«Enumeration»\nOrigineVidéo" as ESource {
    PLATEFORME
    YOUTUBE
  }

  enum "«Enumeration»\nTypeAppréciation" as EAction {
    AIMÉE
    NON_AIMÉE
  }
}

' On force l'alignement horizontal strict d'un bout à l'autre
ERole -[hidden]right- EStatus
EStatus -[hidden]right- ESource
ESource -[hidden]right- EAction

' ============================================================
' SOUS-SYSTÈME : GestionUtilisateurs
' ============================================================
package "«SousSystème» GestionUtilisateurs" as PkgUser {

  class Administrateur {
    --
    + Modérer_vidéo( in vidéo : Vidéo [1], in décision : StatutVidéo [1] )
    + Approuver( in vidéo : Vidéo [1] )
    + Rejeter( in vidéo : Vidéo [1], in motif : String [1] )
    + Bannir_utilisateur( in utilisateur : Utilisateur [1], in motif : String [1] )
    + Gérer_utilisateurs()
  }

  class Utilisateur {
    - identifiant : UUID [1]
    - email : String [1]
    - motDePasse : String [1]
    - pseudo : String [1]
    - nomAffiché : String [1]
    - biographie : String [0..1]
    - actif : Booléen [1]
    - rôle : Rôle [1]
    - dateInscription : Date [1]
    --
    + S_inscrire( in email : String [1], in motDePasse : String [1], in pseudo : String [1], in intérêts : String [1..*] )
    + Se_connecter( in email : String [1], in motDePasse : String [1] ) : Jeton
    + Modifier_profil( in biographie : String [0..1], in urlPhoto : String [0..1] )
    + Publier_vidéo( in titre : String [1], in fichier : Fichier [1], in catégorie : Catégorie [1] ) : Vidéo
    + Rechercher( in requête : String [1] ) : Vidéo [*]
  }

  class PréférenceUtilisateur {
    - catégorie : String [1]
    - poids : Réel [1]
    --
    + Mettre_à_jour( in poids : Réel [1] )
  }

  Administrateur --|> Utilisateur
  Utilisateur "1" *-- "1..*" PréférenceUtilisateur : possède
}

' ============================================================
' SOUS-SYSTÈME : GestionVidéos
' ============================================================
package "«SousSystème» GestionVidéos" as PkgVideo {

  class Vidéo {
    - identifiant : String [1]
    - titre : String [1]
    - description : String [0..1]
    - durée : Entier [1]
    - urlMiniature : String [1]
    - nombreVues : Entier [1]
    - statut : StatutVidéo [1]
    - origine : OrigineVidéo [1]
    - datePublication : Date [0..1]
    --
    + Lire() : Flux
    + Incrémenter_vues()
  }

  class Catégorie {
    - identifiant : String [1]
    - nom : String [1]
    --
    + Lister_vidéos() : Vidéo [*]
  }

  class SessionVisionnage {
    - identifiant : UUID [1]
    - durée : Entier [1]
    - pourcentageComplété : Réel [1]
    - date : Date [1]
    --
    + Enregistrer()
  }

  class Appréciation {
    - type : TypeAppréciation [1]
    - date : Date [1]
    --
    + Enregistrer()
  }

  Vidéo "*" o-- "1" Catégorie         : classée dans
  Vidéo "1" *-- "*" SessionVisionnage : tracée par
  Vidéo "1" *-- "*" Appréciation      : appréciée par
}

' ============================================================
' Relations inter-sous-systèmes & Layout Hints
' ============================================================
' 1. On force le bloc vidéo à droite de l'utilisateur
Utilisateur "1" -right- "*" Vidéo             : publie
Utilisateur "1" -right- "*" SessionVisionnage : réalise
Utilisateur "1" -right- "*" Appréciation      : émet

' 2. LA MAGIE DU PLACEMENT ICI :
' On dit à PlantUML de placer le bloc d'énumérations AU-DESSUS de la classe Vidéo
ERole -[hidden]down- Vidéo
' Optionnel : on dit à l'Administrateur de repousser les énumérations vers la droite
Administrateur -[hidden]right- ERole

@enduml